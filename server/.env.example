# Same service serves the game and WebSocket endpoint.
VITE_GAME_SERVER_URL=/socket
# Optional comma-separated extra frontend origins; same-origin works by default.
PUBLIC_ORIGINS=
HOST=0.0.0.0
# Local port only; Render supplies PORT automatically.
PORT=3000
# Render's proxy can share a source IP; the global 256-connection cap still applies.
MAX_CONNECTIONS_PER_IP=256
